# Build outputs and CI scratch files, all written next to the sources: the
# devctl Makefile's mcp-capi-v<version>-<os>-<arch> and bin-dist/, the
# architect CI's .ldflags, .platforms and mcp-capi-<os>-<arch> (six of them,
# built concurrently). Untracked, any of these flips Go's VCS stamp to
# vcs.modified=true and the binaries built after it report vX.Y.Z+dirty
# (pkg/project reads that stamp when no version ldflag is injected).
/mcp-capi
/mcp-capi-*
/bin-dist/
.ldflags
.platforms
dist/

# Configuration files
.mcp-capi/config.yaml
.cursor/mcp.json

# Go specific
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Go modules
go.sum

# Go workspace file
go.work
go.work.sum

# IDE and editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# Environment variables
.env
.env.local
.env.*.local

# Dependency directories (legacy Node.js, can be removed if not needed)
node_modules/

# Task files
tasks.json
tasks/

# Build artifacts
build/
bin/ mcp-capi

# graphify knowledge graph (regenerable, rebuilt by the post-commit hook)
graphify-out/
