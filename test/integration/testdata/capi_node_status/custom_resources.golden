Node: custom-resources-node

Basic Information:
  UID: <UID>
  Created: <TIMESTAMP>
  Schedulable: true

Node Info:
  OS: linux (Ubuntu 22.04.3 LTS)
  Kernel: 5.15.0-91-generic
  Container Runtime: containerd://1.7.2
  Kubelet: v1.29.0
  Architecture: amd64

Resources:
  Capacity:
    CPU: 16
    Memory: 64Gi
    Pods: 250
  Allocatable:
    CPU: 15500m
    Memory: 62Gi
    Pods: 250

Conditions:
  - Type: Ready
    Status: True
    Reason: KubeletReady
    Message: kubelet is posting ready status

Addresses:
  - InternalIP: 10.0.0.31
  - Hostname: custom-resources-node

Taints:
  - Key: node.kubernetes.io/not-ready
    Effect: NoSchedule
