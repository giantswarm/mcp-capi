{"provider":"aws","requiredCredentials":["AWS_ACCESS_KEY_ID","AWS_SECRET_ACCESS_KEY","AWS_REGION"],"optionalSettings":["AWS_SESSION_TOKEN (temporary credentials)","AWS_PROFILE (use a specific profile)"],"resources":[{"kind":"AWSCluster","description":"Manages VPC, subnets, security groups"},{"kind":"AWSMachine","description":"Individual EC2 instances"},{"kind":"AWSMachineTemplate","description":"Template for creating machines"},{"kind":"AWSManagedControlPlane","description":"EKS-based control plane"}]}