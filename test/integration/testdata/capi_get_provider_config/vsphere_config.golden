{"provider":"vsphere","requiredCredentials":["VSPHERE_SERVER","VSPHERE_USERNAME","VSPHERE_PASSWORD"],"requiredSettings":["VSPHERE_DATACENTER","VSPHERE_DATASTORE","VSPHERE_NETWORK","VSPHERE_RESOURCE_POOL"],"optionalSettings":["VSPHERE_FOLDER","VSPHERE_TEMPLATE (VM template to clone)"],"resources":[{"kind":"VSphereCluster","description":"Manages cluster-level settings"},{"kind":"VSphereMachine","description":"Individual VM instances"},{"kind":"VSphereMachineTemplate","description":"Template for creating machines"}]}